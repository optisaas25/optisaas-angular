# --- DATABASE CONFIG ---
# Never use these example values in a real deployment - generate strong,
# unique secrets per environment. All variables below are REQUIRED; the
# app and docker-compose.prod.yml will refuse to start if they are missing.
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_use_a_strong_random_password
DB_NAME=optisaas

# --- MINIO CONFIG (Object Storage) ---
MINIO_ROOT_USER=CHANGE_ME_do_not_use_minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_use_a_strong_random_password
MINIO_BUCKET=optisaas

# --- AUTH CONFIG ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotate periodically (e.g. every 90 days) and whenever a leak is suspected -
# rotating either secret immediately invalidates all existing sessions/tokens
# signed with the old value, so plan rotations for low-traffic windows.
JWT_SECRET=CHANGE_ME_generate_a_64_byte_random_secret
REFRESH_SECRET=CHANGE_ME_generate_a_different_64_byte_random_secret
FRONTEND_URL=https://votredomaine.com
# Comma-separated list of origins allowed by CORS (in addition to FRONTEND_URL)
CORS_ORIGIN=https://votredomaine.com,https://www.votredomaine.com

# --- n8n CONFIG ---
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_use_a_strong_random_password
DOMAIN_NAME=votredomaine.com

# --- APPLICATION CONFIG ---
NODE_ENV=production
PORT=3000
# How long AuditLog entries (contain PII: names, amounts, IPs) are kept before
# a nightly job purges them. Adjust to your data retention/compliance needs.
AUDIT_LOG_RETENTION_DAYS=180
# Note: Inside docker-compose, endpoints should use service names
MINIO_ENDPOINT=minio
# If Postgres runs in the SAME docker-compose stack as the backend (the default
# setup here), traffic never leaves the internal Docker network and this is fine.
# If you point this at an external/managed Postgres instance instead (a
# separate host, a cloud DB), add "?sslmode=require" (or verify-full with a CA
# cert) so DB credentials and query results aren't sent in cleartext over the
# network.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}
